# Configuración de despliegue (Docker Compose).
# Copia este archivo a .env y ajusta los valores para tu servidor.
#
#   cp .env.example .env
#
# ── Para probar en tu PC, déjalo tal cual (localhost). ──
# ── Para un VPS, reemplaza TU_IP_O_DOMINIO por la IP pública o dominio del VPS. ──

# URL del backend tal como la verá el navegador. OJO: se "hornea" en el build del
# frontend, así que si la cambias hay que reconstruir (docker compose up --build).
VITE_API_URL=http://localhost:4000

# Origen permitido del frontend (CORS). Debe ser la URL desde donde se abre la app.
CLIENT_ORIGIN=http://localhost:8080

# Puertos publicados en el host.
WEB_PORT=8080
SERVER_PORT=4000

# Ejemplo para un VPS con IP 203.0.113.10:
#   VITE_API_URL=http://203.0.113.10:4000
#   CLIENT_ORIGIN=http://203.0.113.10:8080
